<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Label" x:Key="Eyebrow">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.8" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="Label" x:Key="PageTitle">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Label" x:Key="SectionLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="Label" x:Key="BodyText">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.35" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="Label" x:Key="HelpText">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="Label" x:Key="MetricValue">
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Label" x:Key="MetricLabel">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style TargetType="Border" x:Key="HeroCard">
        <Setter Property="BackgroundColor" Value="{StaticResource Ink}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 24" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style TargetType="Border" x:Key="DarkCard" BasedOn="{StaticResource HeroCard}" />
    <Style TargetType="Border" x:Key="MetricCard" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="10,14" />
    </Style>
    <Style TargetType="Border" x:Key="StreakPill">
        <Setter Property="BackgroundColor" Value="#FFF0E8" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="50" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="White" />
    </Style>
    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="Button" x:Key="QuietButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="Button" x:Key="MintButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Mint}" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>
    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="#9AA0B1" />
        <Setter Property="BackgroundColor" Value="#F7F7FA" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="PlaceholderColor" Value="#9AA0B1" />
        <Setter Property="BackgroundColor" Value="#F7F7FA" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="TitleColor" Value="{StaticResource Muted}" />
        <Setter Property="BackgroundColor" Value="#F7F7FA" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="#F7F7FA" />
    </Style>
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="White" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Muted}" />
    </Style>
</ResourceDictionary>
